root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin and Kotlin-script — 4-space indent (Kotlin official style). This is the
# F#-style exception to the .NET templates' tabs-everywhere rule: Kotlin's
# official style and ktlint both use spaces. ktlint reads the keys below.
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
# ktlint rule style. `intellij_idea` matches the IDE's default formatter; switch
# to `ktlint_official` for the stricter upstream style once your code is ready.
ktlint_code_style = intellij_idea
# Mandatory KDoc on every public declaration is too opinionated for a general
# template — enable it per-project if you want enforced docs.
ktlint_standard_kdoc = disabled

# >>> template-only:ktlint-placeholder (scripts/init.* strip this block)
# The sample sources ship under src/{main,test}/kotlin/__PackageName__/ with
# `package __PackageName__`. ktlint's package-name rule rejects the underscores in
# that placeholder token, which would otherwise fail the template's own CI. The
# init script moves these files into the real dotted package and deletes this
# block, after which the rule applies normally to your code.
[src/{main,test}/kotlin/__PackageName__/*.kt]
ktlint_standard_package-name = disabled
# <<< template-only:ktlint-placeholder

# Windows batch files (gradlew.bat) need CRLF — cmd.exe won't parse them otherwise.
[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{toml,json}]
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

# Markdown uses trailing whitespace for hard line breaks — don't strip it.
[*.md]
trim_trailing_whitespace = false
